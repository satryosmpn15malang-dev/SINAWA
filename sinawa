    function startMaosQuiz(level, mode = '1P') {
      maosCurrentLevel = level;
      showScreen('maos-screen');

      document.getElementById('maos-quiz-view').classList.add('hidden');
      document.getElementById('maos-2p-view').classList.add('hidden');
      document.getElementById('maos-result-view').classList.add('hidden');

      if (mode === '1P') {
        const pool = shuffleArray(maosDatabaseExpanded[level]);
        maosQuestions = pool.slice(0, 5).map(q => ({
          ...q,
          options: shuffleArray(q.options)
        }));
        maosCurrentIdx = 0;
        maosScore = 0;

        document.getElementById('maos-quiz-view').classList.remove('hidden');
