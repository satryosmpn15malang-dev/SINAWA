    const ukaraData = [
      { jawa: "ꦱꦶꦤꦲꦸꦗꦮ", latin: "Sinau Jawa", arti: "Belajar Bahasa Jawa" },
      { jawa: "ꦩꦔꦤ꧀ꦱꦠꦺ", latin: "Mangan Sate", arti: "Makan Sate" },
      { jawa: "ꦱꦏꦺꦭꦃꦩꦭꦁ", latin: "Sekolah Malang", arti: "Sekolah di Malang" },
      { jawa: "ꦠꦸꦏꦸꦧꦸꦏꦸ", latin: "Tuku Buku", arti: "Membeli Buku" },
      { jawa: "ꦧꦠꦏꦠꦱꦥ", latin: "Bata Kata Sapa", arti: "Bata Kata Sapa" }
    ];

    function shuffleArray(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    let screenHistory = [];
    let screenForward = [];
    let currentScreenId = 'menu-screen';

    // AUDIO BACKSOUND & SOUND EFFECTS
    let isMusicPlaying = false;
    let musicTimeout = null;
    let audioCtx = null;
    const GAMELAN_NOTES = [261.63, 293.66, 329.63, 392.00, 440.00, 523.25];
    let musicNoteIndex = 0;

    function playGamelanChime() {
      if (!isMusicPlaying) return;
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();

        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        const freq = GAMELAN_NOTES[musicNoteIndex % GAMELAN_NOTES.length];
        musicNoteIndex = (musicNoteIndex + 1) % GAMELAN_NOTES.length;

        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, now);
        gain.gain.setValueAtTime(0.08, now);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.2);

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start(now);
        osc.stop(now + 1.2);

        const nextDelay = 600 + Math.random() * 400;
        musicTimeout = setTimeout(playGamelanChime, nextDelay);
      } catch(e) {}
    }

    function startJawaMusic() {
      if (isMusicPlaying) return;
      isMusicPlaying = true;
      updateMusicUI();
      playGamelanChime();
    }

    function stopJawaMusic() {
      isMusicPlaying = false;
      if (musicTimeout) clearTimeout(musicTimeout);
      updateMusicUI();
    }

    function toggleBackgroundMusic() {
      if (isMusicPlaying) stopJawaMusic();
      else startJawaMusic();
    }

    function updateMusicUI() {
      const icon = document.getElementById('music-icon');
      const text = document.getElementById('music-text');
      const btn = document.getElementById('music-toggle-btn');
      if (icon && text && btn) {
        if (isMusicPlaying) {
          icon.className = 'fa-solid fa-music text-amber-300 animate-pulse';
          text.innerText = 'Musik On';
          btn.classList.add('bg-amber-700');
        } else {
          icon.className = 'fa-solid fa-volume-xmark text-stone-400';
          text.innerText = 'Musik Off';
          btn.classList.remove('bg-amber-700');
        }
      }
    }

    function startAppWithMusic() {
      if (!isMusicPlaying) startJawaMusic();
      showScreen('select-screen');
    }

    function playAudioPop() {
      playSound('pop');
    }

    function playSound(type) {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);

        if (type === 'correct') {
          osc.frequency.setValueAtTime(587.33, ctx.currentTime);
          osc.frequency.setValueAtTime(880, ctx.currentTime + 0.1);
          gain.gain.setValueAtTime(0.2, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.3);
          osc.start();
          osc.stop(ctx.currentTime + 0.3);
        } else if (type === 'wrong') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(160, ctx.currentTime);
          gain.gain.setValueAtTime(0.2, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.3);
          osc.start();
          osc.stop(ctx.currentTime + 0.3);
        } else if (type === 'pop') {
          osc.frequency.setValueAtTime(450, ctx.currentTime);
          gain.gain.setValueAtTime(0.08, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);
          osc.start();
          osc.stop(ctx.currentTime + 0.08);
        }
      } catch(e) {}
    }

    function showScreen(screenId, isNavigatingHistory = false) {
      if (!isNavigatingHistory && currentScreenId !== screenId) {
        screenHistory.push(currentScreenId);
        screenForward = [];
      }
      currentScreenId = screenId;

      const screens = ['menu-screen', 'select-screen', 'sinau-screen', 'maos-screen', 'tangkap-screen', 'nyusun-screen', 'gelembung-screen'];
      screens.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.add('hidden');
      });

      const target = document.getElementById(screenId);
      if (target) target.classList.remove('hidden');

      updateNavButtons();

      if (screenId !== 'tangkap-screen') {
        tangkapActive = false;
        tangkap2PActive = false;
      }
      if (screenId !== 'gelembung-screen') {
        gelembungActive1P = false;
        gelembungActive2P = false;
      }
      stopAllGameTimers();

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function goBackScreen() {
      if (screenHistory.length > 0) {
        screenForward.push(currentScreenId);
        const previous = screenHistory.pop();
        showScreen(previous, true);
      }
    }

    function goNextScreen() {
      if (screenForward.length > 0) {
        screenHistory.push(currentScreenId);
        const next = screenForward.pop();
        showScreen(next, true);
      }
    }

    function updateNavButtons() {
      const navHome = document.getElementById('nav-home-btn');
      const navBack = document.getElementById('nav-back-btn');
      const navNext = document.getElementById('nav-next-btn');

      if (currentScreenId === 'menu-screen') {
        if (navHome) navHome.classList.add('hidden');
      } else {
        if (navHome) navHome.classList.remove('hidden');
      }

      if (navBack) {
        if (screenHistory.length > 0) navBack.classList.replace('hidden', 'flex');
        else navBack.classList.replace('flex', 'hidden');
      }

      if (navNext) {
        if (screenForward.length > 0) navNext.classList.replace('hidden', 'flex');
        else navNext.classList.replace('flex', 'hidden');
      }
    }

