    function spawnBubble(canvasWidth, canvasHeight, targetObj) {
      const isTarget = Math.random() < 0.45;
      const charData = isTarget ? targetObj : carakanData[Math.floor(Math.random() * carakanData.length)];
      const radius = 32 + Math.random() * 8;
      
      const hues = [190, 160, 210, 45, 330];
      const hue = hues[Math.floor(Math.random() * hues.length)];

      return {
        x: radius + Math.random() * (canvasWidth - radius * 2),
        y: canvasHeight + radius + Math.random() * 30,
        radius: radius,
        speedY: (1.2 + Math.random() * 1.5) * gelembungSpeedMult,
        speedX: (Math.random() - 0.5) * 0.8,
        charData: charData,
        hue: hue,
        popped: false
      };
    }

    function gameLoopGelembung1P() {
      if (!gelembungActive1P) return;

      const canvas = document.getElementById('gelembungCanvas1P');
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (Math.random() < 0.04 && bubbles1P.length < 7) {
        bubbles1P.push(spawnBubble(canvas.width, canvas.height, gelembungTargetChar));
      }

      for (let i = bubbles1P.length - 1; i >= 0; i--) {
        let b = bubbles1P[i];
        b.y -= b.speedY;
        b.x += b.speedX;

        drawBubble(ctx, b);

        if (b.y + b.radius < 0) {
          bubbles1P.splice(i, 1);
        }
      }

      animFrameGelembung1P = requestAnimationFrame(gameLoopGelembung1P);
    }

    function drawBubble(ctx, b) {
      ctx.save();
      
      // Main Bubble Glass Effect
      const grad = ctx.createRadialGradient(
        b.x - b.radius * 0.3, b.y - b.radius * 0.3, b.radius * 0.1,
        b.x, b.y, b.radius
      );
      grad.addColorStop(0, `hsla(${b.hue}, 90%, 85%, 0.95)`);
      grad.addColorStop(0.7, `hsla(${b.hue}, 80%, 50%, 0.6)`);
      grad.addColorStop(1, `hsla(${b.hue}, 90%, 35%, 0.8)`);

      ctx.beginPath();
      ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);
      ctx.fillStyle = grad;
      ctx.fill();

      // Highlight sheen
      ctx.beginPath();
      ctx.arc(b.x - b.radius * 0.35, b.y - b.radius * 0.35, b.radius * 0.25, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.7)';
      ctx.fill();

      // Aksara Text Inside
      ctx.fillStyle = '#ffffff';
      ctx.shadowColor = 'rgba(0,0,0,0.5)';
      ctx.shadowBlur = 4;
      ctx.font = `bold ${Math.round(b.radius * 0.95)}px 'Noto Sans Javanese', sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(b.charData.jawa, b.x, b.y + 2);

      ctx.restore();
    }

    function handleCanvasClick1P(e, canvas) {
      if (!gelembungActive1P) return;

      const rect = canvas.getBoundingClientRect();
      const clickX = (e.clientX - rect.left) * (canvas.width / rect.width);
      const clickY = (e.clientY - rect.top) * (canvas.height / rect.height);

      for (let i = bubbles1P.length - 1; i >= 0; i--) {
        let b = bubbles1P[i];
        const dist = Math.hypot(clickX - b.x, clickY - b.y);

        if (dist <= b.radius) {
          bubbles1P.splice(i, 1);

          if (b.charData.latin === gelembungTargetChar.latin) {
            playSound('correct');
            gelembungScore += 10;
            gelembungRound++;

            if (gelembungRound > 10) {
              gelembungActive1P = false;
              playSound('correct');
              alert(`🎉 Slamet! Ronde sampun rampung.\nSkor Akhir Sampeyan: ${gelembungScore}`);
              showScreen('select-screen');
              return;
            } else {
              pickNewGelembungTarget1P();
            }
          } else {
            playSound('wrong');
            gelembungLives--;
            if (gelembungLives <= 0) {
              gelembungActive1P = false;
              alert(`❌ Game Over! Nyawa telas.\nSkor Akhir: ${gelembungScore}`);
              showScreen('select-screen');
              return;
            }
          }
          updateGelembungHUD1P();
          break;
        }
      }
    }

    /* 2P GELEMBUNG SPLIT SCREEN LOOP */
    function gameLoopGelembung2P() {
      if (!gelembungActive2P) return;

      // Render P1 Canvas
      const c1 = document.getElementById('gelembungCanvasP1');
      const ctx1 = c1.getContext('2d');
      ctx1.clearRect(0, 0, c1.width, c1.height);

      if (Math.random() < 0.045 && bubblesP1.length < 6) {
        bubblesP1.push(spawnBubble(c1.width, c1.height, g2pP1Target));
      }

      for (let i = bubblesP1.length - 1; i >= 0; i--) {
        let b = bubblesP1[i];
        b.y -= b.speedY; b.x += b.speedX;
        drawBubble(ctx1, b);
        if (b.y + b.radius < 0) bubblesP1.splice(i, 1);
      }

      // Render P2 Canvas
      const c2 = document.getElementById('gelembungCanvasP2');
      const ctx2 = c2.getContext('2d');
      ctx2.clearRect(0, 0, c2.width, c2.height);

      if (Math.random() < 0.045 && bubblesP2.length < 6) {
        bubblesP2.push(spawnBubble(c2.width, c2.height, g2pP2Target));
      }

      for (let i = bubblesP2.length - 1; i >= 0; i--) {
        let b = bubblesP2[i];
        b.y -= b.speedY; b.x += b.speedX;
        drawBubble(ctx2, b);
        if (b.y + b.radius < 0) bubblesP2.splice(i, 1);
      }

      animFrameGelembung2P = requestAnimationFrame(gameLoopGelembung2P);
    }

    function handleCanvasClick2P(player, e, canvas) {
      if (!gelembungActive2P) return;

      const rect = canvas.getBoundingClientRect();
      const clickX = (e.clientX - rect.left) * (canvas.width / rect.width);
      const clickY = (e.clientY - rect.top) * (canvas.height / rect.height);

      const bubblesArr = (player === 'p1') ? bubblesP1 : bubblesP2;
      const targetChar = (player === 'p1') ? g2pP1Target : g2pP2Target;

      for (let i = bubblesArr.length - 1; i >= 0; i--) {
        let b = bubblesArr[i];
        const dist = Math.hypot(clickX - b.x, clickY - b.y);

        if (dist <= b.radius) {
          bubblesArr.splice(i, 1);

          if (b.charData.latin === targetChar.latin) {
            playSound('correct');
            if (player === 'p1') {
              g2pP1Score += 10;
              pickNewGelembungTarget2P('p1');
            } else {
              g2pP2Score += 10;
              pickNewGelembungTarget2P('p2');
            }
          } else {
            playSound('wrong');
            if (player === 'p1') g2pP1Score = Math.max(0, g2pP1Score - 5);
            else g2pP2Score = Math.max(0, g2pP2Score - 5);
          }
          updateGelembungHUD2P();
          break;
        }
      }
    }

    function showGelembung2POver() {
      let winMsg = "";
      if (g2pP1Score > g2pP2Score) winMsg = "🏆 PEMAIN 1 MENANG!";
      else if (g2pP2Score > g2pP1Score) winMsg = "🏆 PEMAIN 2 MENANG!";
      else winMsg = "🤝 SKOR SERI / IMBANG!";

      alert(`${winMsg}\n\nHasil Pertandingan Pecah Gelembung:\nPemain 1: ${g2pP1Score}\nPemain 2: ${g2pP2Score}`);
      showScreen('select-screen');
    }
  </script>
