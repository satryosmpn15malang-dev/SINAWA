      document.getElementById('maos-2p-view').classList.add('hidden');
      document.getElementById('maos-result-view').classList.remove('hidden');

      let winnerText = "";
      if (maosP1Score > maosP2Score) winnerText = "🎉 PEMAIN 1 MENANG! 🏆";
      else if (maosP2Score > maosP1Score) winnerText = "🎉 PEMAIN 2 MENANG! 🏆";
      else winnerText = "🤝 HASIL SERI / IMBANG!";

      document.getElementById('maos-result-title').innerText = winnerText;
      document.getElementById('maos-result-sub').innerText = "Tandingan Maos Aksara Sampun Rampung!";
      document.getElementById('maos-result-body').innerHTML = `
        <div class="grid grid-cols-2 gap-4 text-center">
          <div class="bg-indigo-100 p-3 rounded-xl border border-indigo-300">
            <div class="text-xs font-bold text-indigo-800">PEMAIN 1</div>
            <div class="text-3xl font-black text-indigo-950">${maosP1Score}</div>
          </div>
          <div class="bg-emerald-100 p-3 rounded-xl border border-emerald-300">
            <div class="text-xs font-bold text-emerald-800">PEMAIN 2</div>
            <div class="text-3xl font-black text-emerald-950">${maosP2Score}</div>
          </div>
        </div>
      `;
    }

    /* ---------------- MODE 3: TANGKAP AKSARA (1P & 2P) ---------------- */
    let tangkapMode = '1P';
    let tangkapActive = false, tangkap2PActive = false;
    let tangkapScore = 0, tangkapLives = 3, tangkapTarget = null;
    let basketX = 160;
    let fallingItems = [];
    let animFrameId = null;
    let tangkapSpeedFactor = 0.8;

    let t2pTimer = 40;
    let t2pP1Score = 0, t2pP2Score = 0;
    let t2pP1Lives = 3, t2pP2Lives = 3;
    let t2pP1Target = null, t2pP2Target = null;
    let t2pBasketP1X = 120, t2pBasketP2X = 120;
    let t2pFallingP1 = [], t2pFallingP2 = [];

    function triggerTangkapFromCard() { startTangkapDirect('1P'); }

    function startTangkapDirect(playerMode) {
      tangkapMode = playerMode;
      const speedChoice = document.getElementById('tangkap-speed-select').value;
      if (speedChoice === 'alon') tangkapSpeedFactor = 0.5;
      else if (speedChoice === 'sedengan') tangkapSpeedFactor = 0.9;
      else tangkapSpeedFactor = 1.4;

      showScreen('tangkap-screen');
      setTimeout(initTangkapGame, 100);
    }

    function initTangkapGame() {
      if (animFrameId) cancelAnimationFrame(animFrameId);
      stopAllGameTimers();

      const container1P = document.getElementById('tangkap-1p-container');
      const container2P = document.getElementById('tangkap-2p-container');

      if (tangkapMode === '1P') {
        container1P.classList.remove('hidden');
        container2P.classList.add('hidden');

        document.getElementById('tangkap-mode-title').innerText = "3. Tangkap Aksara (1 Pemain)";
        document.getElementById('tangkap-mode-desc').innerText = "Geser keranjang menyang kiwa/tengen kanggo nangkep aksara sing bener!";

        const canvas = document.getElementById('tangkapCanvas');
        canvas.width = 400; canvas.height = 300;

        tangkapScore = 0; tangkapLives = 3; basketX = 160;
        fallingItems = []; tangkapActive = true;

        pickNewTangkapTarget();
        updateTangkapHUD();

        window.onkeydown = (e) => {
          if (e.key === "ArrowLeft" || e.key === "a" || e.key === "A") basketX = Math.max(0, basketX - 25);
          if (e.key === "ArrowRight" || e.key === "d" || e.key === "D") basketX = Math.min(320, basketX + 25);
        };

        const btnLeft = document.getElementById('btn-left');
        const btnRight = document.getElementById('btn-right');
        if (btnLeft && btnRight) {
          btnLeft.onclick = () => { basketX = Math.max(0, basketX - 30); playSound('pop'); };
          btnRight.onclick = () => { basketX = Math.min(320, basketX + 30); playSound('pop'); };
        }

        tangkapGameLoop1P();

      } else {
        container1P.classList.add('hidden');
        container2P.classList.remove('hidden');

        document.getElementById('tangkap-mode-title').innerText = "3. Tangkap Aksara (2 Pemain ⚔️)";
        document.getElementById('tangkap-mode-desc').innerText = "Tandingan nangkep aksara! P1: A/D | P2: Panah Kiwa/Tengen";

        const c1 = document.getElementById('tangkapCanvasP1');
        const c2 = document.getElementById('tangkapCanvasP2');
        c1.width = 320; c1.height = 240;
        c2.width = 320; c2.height = 240;

        t2pTimer = 40;
        t2pP1Score = 0; t2pP2Score = 0;
        t2pP1Lives = 3; t2pP2Lives = 3;
        t2pBasketP1X = 120; t2pBasketP2X = 120;
        t2pFallingP1 = []; t2pFallingP2 = [];
        tangkap2PActive = true;

        t2pP1Target = carakanData[Math.floor(Math.random() * carakanData.length)];
        t2pP2Target = carakanData[Math.floor(Math.random() * carakanData.length)];

        updateTangkap2PHUD();

        window.onkeydown = (e) => {
          if (e.key === "a" || e.key === "A") t2pBasketP1X = Math.max(0, t2pBasketP1X - 25);
          if (e.key === "d" || e.key === "D") t2pBasketP1X = Math.min(240, t2pBasketP1X + 25);
          if (e.key === "ArrowLeft") t2pBasketP2X = Math.max(0, t2pBasketP2X - 25);
          if (e.key === "ArrowRight") t2pBasketP2X = Math.min(240, t2pBasketP2X + 25);
        };

        document.getElementById('t2p-p1-btn-left').onclick = () => { t2pBasketP1X = Math.max(0, t2pBasketP1X - 25); };
        document.getElementById('t2p-p1-btn-right').onclick = () => { t2pBasketP1X = Math.min(240, t2pBasketP1X + 25); };
        document.getElementById('t2p-p2-btn-left').onclick = () => { t2pBasketP2X = Math.max(0, t2pBasketP2X - 25); };
        document.getElementById('t2p-p2-btn-right').onclick = () => { t2pBasketP2X = Math.min(240, t2pBasketP2X + 25); };

        globalTimerInterval = setInterval(() => {
          t2pTimer--;
          document.getElementById('tangkap-2p-timer').innerText = t2pTimer;
          if (t2pTimer <= 0) {
            tangkap2PActive = false;
            stopAllGameTimers();
            showTangkap2POver();
          }
        }, 1000);

        tangkapGameLoop2P();
      }
    }

    function pickNewTangkapTarget() {
      const randomChar = carakanData[Math.floor(Math.random() * carakanData.length)];
      tangkapTarget = randomChar;
      document.getElementById('tangkap-target').innerText = randomChar.latin;
    }

    function updateTangkapHUD() {
      document.getElementById('tangkap-score').innerText = tangkapScore;
      document.getElementById('tangkap-lives').innerText = "❤️".repeat(tangkapLives);
    }

    function updateTangkap2PHUD() {
      document.getElementById('t2p-p1-target').innerText = t2pP1Target.latin;
      document.getElementById('t2p-p2-target').innerText = t2pP2Target.latin;
      document.getElementById('t2p-p1-score').innerText = t2pP1Score;
      document.getElementById('t2p-p2-score').innerText = t2pP2Score;
      document.getElementById('t2p-p1-lives').innerText = "❤️".repeat(Math.max(0, t2pP1Lives));
      document.getElementById('t2p-p2-lives').innerText = "❤️".repeat(Math.max(0, t2pP2Lives));
    }

    function tangkapGameLoop1P() {
      if (!tangkapActive) return;

      const canvas = document.getElementById('tangkapCanvas');
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (Math.random() < 0.02 && fallingItems.length < 3) {
        const isTarget = Math.random() < 0.5;
        const charObj = isTarget ? tangkapTarget : carakanData[Math.floor(Math.random() * carakanData.length)];
        fallingItems.push({
          x: Math.random() * 340 + 10,
          y: -30,
          speed: (0.5 + Math.random() * 0.5) * tangkapSpeedFactor,
          data: charObj
        });
      }

      ctx.fillStyle = "#d97706";
      ctx.beginPath();
      ctx.roundRect(basketX, 260, 80, 25, 8);
      ctx.fill();
      ctx.strokeStyle = "#78350f";
      ctx.lineWidth = 3;
      ctx.stroke();

      ctx.fillStyle = "#ffffff";
      ctx.font = "bold 12px sans-serif";
      ctx.fillText("KERANJANG", basketX + 8, 276);

      for (let i = fallingItems.length - 1; i >= 0; i--) {
        let item = fallingItems[i];
        item.y += item.speed;

        ctx.fillStyle = "#fef3c7";
        ctx.beginPath();
        ctx.arc(item.x + 15, item.y + 15, 20, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "#d97706";
        ctx.lineWidth = 2;
        ctx.stroke();

        ctx.fillStyle = "#362419";
        ctx.font = "bold 20px 'Noto Sans Javanese', sans-serif";
        ctx.fillText(item.data.jawa, item.x + 5, item.y + 22);

        if (item.y + 30 >= 260 && item.x + 30 >= basketX && item.x <= basketX + 80) {
          if (item.data.latin === tangkapTarget.latin) {
            playSound('correct');
            tangkapScore += 10;
            pickNewTangkapTarget();
          } else {
            playSound('wrong');
            tangkapLives--;
            if (tangkapLives <= 0) {
              tangkapActive = false;
              alert(`Game Over! Skor Akhir Anda: ${tangkapScore}`);
              initTangkapGame();
              return;
            }
          }
          updateTangkapHUD();
          fallingItems.splice(i, 1);
          continue;
        }

        if (item.y > 300) fallingItems.splice(i, 1);
      }

      animFrameId = requestAnimationFrame(tangkapGameLoop1P);
    }

    function tangkapGameLoop2P() {
      if (!tangkap2PActive) return;

      const c1 = document.getElementById('tangkapCanvasP1');
      const ctx1 = c1.getContext('2d');
      ctx1.clearRect(0, 0, c1.width, c1.height);

      if (Math.random() < 0.025 && t2pFallingP1.length < 3) {
        const isTarget = Math.random() < 0.5;
        t2pFallingP1.push({
          x: Math.random() * 260 + 10,
          y: -20,
          speed: (0.6 + Math.random() * 0.6) * tangkapSpeedFactor,
          data: isTarget ? t2pP1Target : carakanData[Math.floor(Math.random() * carakanData.length)]
        });
      }

      ctx1.fillStyle = "#4f46e5";
      ctx1.beginPath();
      ctx1.roundRect(t2pBasketP1X, 205, 80, 22, 6);
      ctx1.fill();

      for (let i = t2pFallingP1.length - 1; i >= 0; i--) {
        let item = t2pFallingP1[i];
        item.y += item.speed;

        ctx1.fillStyle = "#e0e7ff";
        ctx1.beginPath();
        ctx1.arc(item.x + 12, item.y + 12, 16, 0, Math.PI * 2);
        ctx1.fill();

        ctx1.fillStyle = "#1e1b4b";
        ctx1.font = "bold 16px 'Noto Sans Javanese', sans-serif";
        ctx1.fillText(item.data.jawa, item.x + 4, item.y + 18);

        if (item.y + 24 >= 205 && item.x + 24 >= t2pBasketP1X && item.x <= t2pBasketP1X + 80) {
          if (item.data.latin === t2pP1Target.latin) {
            playSound('correct');
            t2pP1Score += 10;
            t2pP1Target = carakanData[Math.floor(Math.random() * carakanData.length)];
          } else {
            playSound('wrong');
            t2pP1Lives--;
          }
          updateTangkap2PHUD();
          t2pFallingP1.splice(i, 1);
          continue;
        }
        if (item.y > 240) t2pFallingP1.splice(i, 1);
      }

      const c2 = document.getElementById('tangkapCanvasP2');
      const ctx2 = c2.getContext('2d');
      ctx2.clearRect(0, 0, c2.width, c2.height);

      if (Math.random() < 0.025 && t2pFallingP2.length < 3) {
        const isTarget = Math.random() < 0.5;
        t2pFallingP2.push({
          x: Math.random() * 260 + 10,
          y: -20,
          speed: (0.6 + Math.random() * 0.6) * tangkapSpeedFactor,
          data: isTarget ? t2pP2Target : carakanData[Math.floor(Math.random() * carakanData.length)]
        });
      }

      ctx2.fillStyle = "#059669";
      ctx2.beginPath();
      ctx2.roundRect(t2pBasketP2X, 205, 80, 22, 6);
      ctx2.fill();

      for (let i = t2pFallingP2.length - 1; i >= 0; i--) {
        let item = t2pFallingP2[i];
        item.y += item.speed;

        ctx2.fillStyle = "#d1fae5";
        ctx2.beginPath();
        ctx2.arc(item.x + 12, item.y + 12, 16, 0, Math.PI * 2);
        ctx2.fill();

        ctx2.fillStyle = "#064e3b";
        ctx2.font = "bold 16px 'Noto Sans Javanese', sans-serif";
        ctx2.fillText(item.data.jawa, item.x + 4, item.y + 18);

        if (item.y + 24 >= 205 && item.x + 24 >= t2pBasketP2X && item.x <= t2pBasketP2X + 80) {
          if (item.data.latin === t2pP2Target.latin) {
