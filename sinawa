    function loadMaosQuestion() {
      const qData = maosQuestions[maosCurrentIdx];
      document.getElementById('maos-score').innerText = maosScore;
      document.getElementById('maos-progress').innerText = `${maosCurrentIdx + 1}/${maosQuestions.length}`;
      document.getElementById('maos-question-display').innerText = qData.q;
      
      const feedback = document.getElementById('maos-feedback');
      feedback.className = "hidden p-3 text-center rounded-xl font-bold text-sm";

      const container = document.getElementById('maos-options-container');
      container.innerHTML = qData.options.map(opt => `
        <button onclick="playAudioPop(); checkMaosAnswer('${opt}')" class="wood-card p-4 text-amber-950 font-black text-lg hover:border-amber-600 transition active:scale-95">
          ${opt}
        </button>
      `).join('');
    }

    function checkMaosAnswer(selected) {
      const qData = maosQuestions[maosCurrentIdx];
      const feedback = document.getElementById('maos-feedback');
      feedback.classList.remove('hidden');

      if (selected === qData.ans) {
        playSound('correct');
        maosScore += 20;
        feedback.className = "p-3 text-center rounded-xl font-bold text-sm bg-emerald-100 text-emerald-800 border-2 border-emerald-400";
        feedback.innerHTML = `<i class="fa-solid fa-circle-check"></i> Bener! Jawaban sampeyan tepat.`;
      } else {
        playSound('wrong');
        feedback.className = "p-3 text-center rounded-xl font-bold text-sm bg-rose-100 text-rose-800 border-2 border-rose-400";
        feedback.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> Kurang Tepat! Jawaban sing bener: <strong>${qData.ans}</strong>`;
      }

      setTimeout(() => {
        maosCurrentIdx++;
        if (maosCurrentIdx < maosQuestions.length) {
          loadMaosQuestion();
        } else {
          showMaos1PResult();
        }
      }, 1000);
    }

    function loadMaos2PQ(player) {
      const pool = maosDatabaseExpanded[maosCurrentLevel];
      const randomQ = pool[Math.floor(Math.random() * pool.length)];
      const item = { ...randomQ, options: shuffleArray(randomQ.options) };

      if (player === 'p1') {
        maosP1Q = item;
        document.getElementById('maos-p1-q').innerText = item.q;
        document.getElementById('maos-p1-opts').innerHTML = item.options.map(opt => `
          <button onclick="checkMaos2PAnswer('p1', '${opt}')" class="wood-card py-2.5 px-2 text-indigo-950 font-extrabold text-sm hover:bg-indigo-50 border-indigo-300">
            ${opt}
          </button>
        `).join('');
      } else {
        maosP2Q = item;
        document.getElementById('maos-p2-q').innerText = item.q;
        document.getElementById('maos-p2-opts').innerHTML = item.options.map(opt => `
          <button onclick="checkMaos2PAnswer('p2', '${opt}')" class="wood-card py-2.5 px-2 text-emerald-950 font-extrabold text-sm hover:bg-emerald-50 border-emerald-300">
            ${opt}
          </button>
        `).join('');
      }
    }

    function checkMaos2PAnswer(player, selected) {
      const q = (player === 'p1') ? maosP1Q : maosP2Q;
      const msgEl = document.getElementById(player === 'p1' ? 'maos-p1-msg' : 'maos-p2-msg');

      if (selected === q.ans) {
        playSound('correct');
        if (player === 'p1') {
          maosP1Score += 10;
          document.getElementById('maos-p1-score').innerText = maosP1Score;
          msgEl.className = "text-xs text-center font-bold text-emerald-600";
          msgEl.innerText = "✨ Bener (+10)";
        } else {
          maosP2Score += 10;
          document.getElementById('maos-p2-score').innerText = maosP2Score;
          msgEl.className = "text-xs text-center font-bold text-emerald-600";
          msgEl.innerText = "✨ Bener (+10)";
        }
      } else {
        playSound('wrong');
        msgEl.className = "text-xs text-center font-bold text-rose-600";
        msgEl.innerText = "❌ Salah!";
      }

      setTimeout(() => {
        msgEl.innerText = "";
        loadMaos2PQ(player);
      }, 500);
    }

    function showMaos1PResult() {
      document.getElementById('maos-quiz-view').classList.add('hidden');
      document.getElementById('maos-result-view').classList.remove('hidden');
      document.getElementById('maos-result-title').innerText = "Hasil Maos Aksara";
      document.getElementById('maos-result-sub').innerText = "Pak Satryo bangga kalih usaha sampeyan!";
      document.getElementById('maos-result-body').innerHTML = `
        <span class="text-xs text-stone-500 uppercase font-bold tracking-wider">Skor Akhir</span>
        <div class="text-5xl font-black text-amber-800 my-1">${maosScore}</div>
      `;
    }

