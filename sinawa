        document.getElementById('maos-p1-score').innerText = 0;
        document.getElementById('maos-p2-score').innerText = 0;
        document.getElementById('maos-2p-timer').innerText = maos2PTimer;

        loadMaos2PQ('p1');
        loadMaos2PQ('p2');

        stopAllGameTimers();
        globalTimerInterval = setInterval(() => {
