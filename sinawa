          updateTangkap2PHUD();
          t2pFallingP2.splice(i, 1);
          continue;
        }
        if (item.y > 240) t2pFallingP2.splice(i, 1);
      }

      if (t2pP1Lives <= 0 || t2pP2Lives <= 0) {
        tangkap2PActive = false;
        stopAllGameTimers();
        showTangkap2POver();
        return;
      }

