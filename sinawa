<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sinau Aksara Jawa - Pak Satryo, S.Pd</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Javanese:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;600;700;800;900&family=Fredoka:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: #e2f4f2;
      background-image: radial-gradient(#b2e0dc 1.5px, transparent 1.5px);
      background-size: 24px 24px;
      color: #362419;
    }
    .font-jawa {
      font-family: 'Noto Sans Javanese', 'Segoe UI Historic', serif;
    }
    .font-game {
      font-family: 'Fredoka', 'Plus Jakarta Sans', sans-serif;
    }
    .bg-batik {
      background-color: #2a1b12;
      background-image: radial-gradient(#d4a359 0.75px, transparent 0.75px), radial-gradient(#d4a359 0.75px, #2a1b12 0.75px);
      background-size: 30px 30px;
      background-position: 0 0, 15px 15px;
    }
    .wood-card {
      background: #ffffff;
      border: 3.5px solid #7c4013;
      box-shadow: 0 8px 0px #522707, 0 15px 25px rgba(82, 39, 7, 0.15);
      border-radius: 20px;
      transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .card-interactive {
      cursor: pointer;
    }
    .card-interactive:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 14px 0px #522707, 0 20px 30px rgba(82, 39, 7, 0.25);
      border-color: #b45309;
    }
    .card-interactive:hover .char-img {
      transform: scale(1.08) rotate(2deg);
    }
    .card-interactive:hover .btn-card-action {
      transform: scale(1.05);
      filter: brightness(1.1);
    }
    .btn-jawa {
      background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%);
      border: 2px solid #78350f;
      box-shadow: 0 4px 0px #78350f;
      transition: all 0.15s ease;
    }
    .btn-jawa:hover {
      transform: translateY(-3px) scale(1.03);
      box-shadow: 0 7px 0px #78350f;
      filter: brightness(1.1);
    }
    .btn-jawa:active {
      transform: translateY(2px);
      box-shadow: 0 1px 0px #78350f;
    }
    .btn-green {
      background: linear-gradient(180deg, #10b981 0%, #059669 100%);
      border: 2px solid #065f46;
      box-shadow: 0 4px 0px #065f46;
      transition: all 0.15s ease;
    }
    .btn-green:hover {
      transform: translateY(-3px) scale(1.03);
      box-shadow: 0 7px 0px #065f46;
      filter: brightness(1.1);
    }
    .btn-green:active {
      transform: translateY(2px);
      box-shadow: 0 1px 0px #065f46;
    }
    .btn-blue {
      background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 100%);
      border: 2px solid #1e3a8a;
      box-shadow: 0 4px 0px #1e3a8a;
      transition: all 0.15s ease;
    }
    .btn-blue:hover {
      transform: translateY(-3px) scale(1.03);
      box-shadow: 0 7px 0px #1e3a8a;
      filter: brightness(1.1);
    }
    .wood-banner {
      background: linear-gradient(180deg, #b45309 0%, #78350f 100%);
      border: 3px solid #451a03;
      box-shadow: 0 6px 0px #2a0e02;
    }
    canvas {
      touch-action: none;
    }
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-6px); }
    }
    .animate-float {
      animation: floatSlow 3s ease-in-out infinite;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-amber-200">

  <!-- HEADER -->
  <header class="bg-batik text-amber-100 shadow-lg border-b-4 border-amber-600 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
      <div class="flex items-center space-x-3 cursor-pointer group" onclick="playAudioPop(); showScreen('menu-screen')">
        <div class="w-10 h-10 rounded-full bg-amber-600 flex items-center justify-center font-jawa font-bold text-2xl text-amber-100 border-2 border-amber-300 shadow group-hover:scale-110 transition">
          ꦲ
        </div>
        <div>
          <h1 class="font-extrabold text-lg sm:text-xl tracking-wide text-amber-200 leading-tight">Sinau Aksara Jawa</h1>
          <p class="text-xs text-amber-400 font-medium">SMPN 15 Kota Malang</p>
        </div>
      </div>
      
      <div class="flex items-center gap-2">
        <button id="music-toggle-btn" onclick="toggleBackgroundMusic()" class="px-3 py-1.5 bg-amber-900/90 hover:bg-amber-800 text-amber-200 rounded-xl text-xs sm:text-sm font-semibold flex items-center gap-2 border border-amber-600 shadow transition active:scale-95">
          <i id="music-icon" class="fa-solid fa-volume-xmark text-stone-400"></i>
          <span id="music-text">Musik Off</span>
        </button>

        <button id="nav-back-btn" onclick="playAudioPop(); goBackScreen()" class="hidden px-2.5 py-1.5 bg-amber-900/90 hover:bg-amber-800 text-amber-200 rounded-xl text-xs font-semibold items-center gap-1 border border-amber-600 transition active:scale-95" title="Mundur / Kembali">
          <i class="fa-solid fa-chevron-left"></i>
          <span class="hidden sm:inline">Mundur</span>
        </button>

        <button id="nav-home-btn" onclick="playAudioPop(); showScreen('menu-screen')" class="hidden px-3 py-1.5 bg-amber-900/90 hover:bg-amber-800 text-amber-200 rounded-xl text-xs sm:text-sm font-semibold flex items-center gap-2 border border-amber-600 transition active:scale-95">
          <i class="fa-solid fa-house"></i>
          <span class="hidden sm:inline">Menu Utama</span>
        </button>

        <button id="nav-next-btn" onclick="playAudioPop(); goNextScreen()" class="hidden px-2.5 py-1.5 bg-amber-900/90 hover:bg-amber-800 text-amber-200 rounded-xl text-xs font-semibold items-center gap-1 border border-amber-600 transition active:scale-95" title="Lanjut / Maju">
          <span class="hidden sm:inline">Lanjut</span>
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="flex-grow max-w-7xl w-full mx-auto p-3 sm:p-6 flex flex-col justify-center">

    <!-- MENU UTAMA / WELCOME -->
    <section id="menu-screen" class="space-y-8 my-auto">
      <div class="text-center space-y-4 max-w-2xl mx-auto">
        <div class="inline-block px-4 py-1.5 rounded-full bg-amber-100 text-amber-900 border-2 border-amber-400 font-bold text-xs sm:text-sm shadow-sm mb-2 animate-bounce">
          <i class="fa-solid fa-graduation-cap text-amber-700 mr-1.5"></i> Media Pembelajaran Interaktif Bahasa Jawa
        </div>
        <h2 class="text-4xl sm:text-6xl font-black text-amber-950 tracking-tight drop-shadow-sm">
          Sinau Aksara Jawa
        </h2>
        <p class="font-jawa text-3xl sm:text-4xl text-amber-800 tracking-wider">
          ꦱꦶꦤꦲꦸꦲꦏ꧀ꦱꦫꦗꦮ
        </p>
        <p class="text-stone-700 text-base sm:text-lg max-w-lg mx-auto font-medium">
          Sugeng rawuh! Mari belajar dan melestarikan Aksara Jawa melalui materi lengkap & 5 permainan interaktif Mode Single & Duel 2 Pemain.
        </p>

        <!-- CREATOR CREDIT BOX -->
        <div class="wood-card p-4 rounded-2xl max-w-md mx-auto flex items-center gap-4 text-left border-l-8 border-l-amber-700 mt-6 hover:scale-105 transition">
          <div class="w-12 h-12 rounded-2xl bg-amber-200 flex items-center justify-center text-amber-900 text-2xl font-bold shrink-0 border-2 border-amber-500 shadow">
            <i class="fa-solid fa-chalkboard-user"></i>
          </div>
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-amber-700 block">Dibuat Oleh:</span>
            <h3 class="font-black text-amber-950 text-base sm:text-lg">Satryo, S.Pd</h3>
            <p class="text-xs text-stone-600 font-semibold">Guru Bahasa Jawa - SMPN 15 Kota Malang</p>
          </div>
        </div>
      </div>

      <div class="text-center pt-2">
        <button onclick="playAudioPop(); startAppWithMusic()" class="btn-jawa text-white font-black text-xl sm:text-2xl px-12 py-4 rounded-2xl shadow-xl flex items-center gap-3 mx-auto">
          <span>WIWITI</span>
          <i class="fa-solid fa-circle-play text-2xl"></i>
        </button>
      </div>
    </section>

    <!-- SELECT SCREEN (MODE SELECTION) -->
    <section id="select-screen" class="hidden space-y-6">
      
      <div class="text-center relative max-w-xs mx-auto">
        <div class="wood-banner text-amber-100 font-game font-black text-2xl sm:text-3xl py-2.5 px-8 rounded-2xl inline-flex items-center justify-center gap-2 tracking-widest uppercase shadow-lg">
          <i class="fa-solid fa-leaf text-emerald-400 text-lg"></i>
          <span>MENU UTAMA</span>
          <i class="fa-solid fa-leaf text-emerald-400 text-lg"></i>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5 max-w-7xl mx-auto pt-2">
        
        <!-- CARD 1: SINAU AKSARA -->
        <div onclick="playAudioPop(); openSinauModule()" class="wood-card card-interactive p-5 flex flex-col justify-between items-center text-center group">
          <div class="w-full flex justify-center py-2 relative">
            <svg class="w-32 h-36 char-img transition-transform duration-300" viewBox="0 0 160 180" fill="none">
              <path d="M40 70 C40 30, 120 30, 120 70 C120 75, 40 75, 40 70 Z" fill="#522707"/>
              <ellipse cx="80" cy="45" rx="42" ry="25" fill="#6d3509"/>
              <circle cx="120" cy="65" r="10" fill="#421d04"/>
              <ellipse cx="80" cy="80" rx="35" ry="32" fill="#ffd8b3"/>
              <circle cx="68" cy="78" r="4" fill="#2d1810"/>
              <circle cx="92" cy="78" r="4" fill="#2d1810"/>
              <path d="M73 90 Q80 97 87 90" stroke="#8b4513" stroke-width="3" stroke-linecap="round" fill="none"/>
              <circle cx="62" cy="84" r="5" fill="#ffb3b3" opacity="0.6"/>
              <circle cx="98" cy="84" r="5" fill="#ffb3b3" opacity="0.6"/>
              <path d="M50 110 L110 110 L125 170 L35 170 Z" fill="#8b5a2b"/>
              <rect x="58" y="125" width="44" height="35" rx="4" fill="#1d4ed8" stroke="#ffffff" stroke-width="2"/>
              <path d="M80 125 L80 160" stroke="#ffffff" stroke-width="1.5"/>
              <text x="65" y="148" font-family="'Noto Sans Javanese'" font-size="16" fill="#ffffff" font-weight="bold">ꦲ</text>
            </svg>
          </div>

          <div class="space-y-2 my-2">
            <h3 class="font-game font-black text-lg text-amber-950 uppercase tracking-wide">1. SINAU AKSARA</h3>
            <p class="text-xs text-stone-600 font-semibold px-1">Pengenalan, Carakan, Pasangan, Sandhangan & Ukara.</p>
          </div>

          <div class="w-full pt-3">
            <button class="btn-jawa btn-card-action w-full py-2.5 rounded-xl font-game font-extrabold text-white text-sm uppercase tracking-wider">
              BUKAK MATERI
            </button>
          </div>
        </div>

        <!-- CARD 2: MAOS AKSARA -->
        <div class="wood-card card-interactive p-5 flex flex-col justify-between items-center text-center group" onclick="playAudioPop(); triggerMaosFromCard()">
          <div class="w-full flex justify-center py-2">
            <svg class="w-32 h-36 char-img transition-transform duration-300" viewBox="0 0 160 180" fill="none">
              <ellipse cx="80" cy="45" rx="42" ry="25" fill="#6d3509"/>
              <path d="M40 70 C40 30, 120 30, 120 70 C120 75, 40 75, 40 70 Z" fill="#522707"/>
              <circle cx="120" cy="65" r="10" fill="#421d04"/>
              <ellipse cx="80" cy="80" rx="35" ry="32" fill="#ffd8b3"/>
              <path d="M63 76 Q68 70 73 76" stroke="#2d1810" stroke-width="3" stroke-linecap="round" fill="none"/>
              <path d="M87 76 Q92 70 97 76" stroke="#2d1810" stroke-width="3" stroke-linecap="round" fill="none"/>
              <path d="M72 88 Q80 97 88 88" stroke="#8b4513" stroke-width="3" stroke-linecap="round" fill="none"/>
              <path d="M50 110 L110 110 L125 170 L35 170 Z" fill="#8b5a2b"/>
              <path d="M50 120 Q80 125 80 155 Q50 150 50 120 Z" fill="#2563eb" stroke="#ffffff"/>
              <path d="M110 120 Q80 125 80 155 Q110 150 110 120 Z" fill="#3b82f6" stroke="#ffffff"/>
              <text x="58" y="142" font-family="'Noto Sans Javanese'" font-size="14" fill="#ffffff">ꦩ</text>
            </svg>
          </div>

          <div class="space-y-2 my-2 w-full">
            <h3 class="font-game font-black text-lg text-amber-950 uppercase tracking-wide">2. MAOS AKSARA</h3>
            <p class="text-xs text-stone-600 font-semibold px-1">Kuis pilihan ganda maca aksara Jawa.</p>
            
            <div class="pt-1" onclick="event.stopPropagation()">
              <select id="maos-level-select-input" class="w-full bg-amber-50 border-2 border-amber-800 text-amber-950 text-xs font-extrabold rounded-lg p-1.5 focus:outline-none cursor-pointer text-center">
                <option value="gampang">Level: GAMPANG</option>
                <option value="sedengan">Level: SEDENGAN</option>
                <option value="angel">Level: ANGEL</option>
              </select>
            </div>
          </div>

          <div class="w-full pt-2 flex gap-1.5" onclick="event.stopPropagation()">
            <button onclick="playAudioPop(); startMaosQuizDirect('1P')" class="btn-green btn-card-action flex-1 py-2 rounded-xl font-game font-bold text-white text-xs uppercase tracking-wider">
              1 Pemain
            </button>
            <button onclick="playAudioPop(); startMaosQuizDirect('2P')" class="btn-blue btn-card-action flex-1 py-2 rounded-xl font-game font-bold text-white text-xs uppercase tracking-wider">
              2P ⚔️
            </button>
          </div>
        </div>

        <!-- CARD 3: TANGKAP AKSARA -->
        <div class="wood-card card-interactive p-5 flex flex-col justify-between items-center text-center group" onclick="playAudioPop(); triggerTangkapFromCard()">
          <div class="w-full flex justify-center py-2">
            <svg class="w-32 h-36 char-img transition-transform duration-300" viewBox="0 0 160 180" fill="none">
              <ellipse cx="80" cy="45" rx="42" ry="25" fill="#6d3509"/>
              <path d="M40 70 C40 30, 120 30, 120 70 C120 75, 40 75, 40 70 Z" fill="#522707"/>
              <circle cx="120" cy="65" r="10" fill="#421d04"/>
              <ellipse cx="80" cy="80" rx="35" ry="32" fill="#ffd8b3"/>
              <circle cx="68" cy="76" r="5" fill="#2d1810"/>
              <circle cx="92" cy="76" r="5" fill="#2d1810"/>
              <path d="M70 88 Q80 100 90 88 Z" fill="#8b4513"/>
              <path d="M50 110 L110 110 L125 170 L35 170 Z" fill="#8b5a2b"/>
              <path d="M50 135 L110 135 L102 165 L58 165 Z" fill="#d97706" stroke="#78350f" stroke-width="2"/>
            </svg>
          </div>

          <div class="space-y-2 my-2 w-full">
            <h3 class="font-game font-black text-lg text-amber-950 uppercase tracking-wide">3. TANGKAP AKSARA</h3>
            <p class="text-xs text-stone-600 font-semibold px-1">Tangkap aksara sing bener gogrog!</p>

            <div class="pt-1" onclick="event.stopPropagation()">
              <select id="tangkap-speed-select" class="w-full bg-amber-50 border-2 border-amber-800 text-amber-950 text-xs font-extrabold rounded-lg p-1.5 focus:outline-none cursor-pointer text-center">
                <option value="alon">Kecepatan: ALON</option>
                <option value="sedengan">Kecepatan: SEDENGAN</option>
                <option value="banter">Kecepatan: BANTER</option>
              </select>
            </div>
          </div>

          <div class="w-full pt-2 flex gap-1.5" onclick="event.stopPropagation()">
            <button onclick="playAudioPop(); startTangkapDirect('1P')" class="btn-green btn-card-action flex-1 py-2 rounded-xl font-game font-bold text-white text-xs uppercase tracking-wider">
              1 Pemain
            </button>
            <button onclick="playAudioPop(); startTangkapDirect('2P')" class="btn-blue btn-card-action flex-1 py-2 rounded-xl font-game font-bold text-white text-xs uppercase tracking-wider">
              2P ⚔️
            </button>
          </div>
        </div>

        <!-- CARD 4: NYUSUN AKSARA -->
        <div class="wood-card card-interactive p-5 flex flex-col justify-between items-center text-center group" onclick="playAudioPop(); triggerNyusunFromCard()">
          <div class="w-full flex justify-center py-2 relative">
            <svg class="w-32 h-36 char-img transition-transform duration-300" viewBox="0 0 160 180" fill="none">
              <ellipse cx="80" cy="45" rx="42" ry="25" fill="#6d3509"/>
              <path d="M40 70 C40 30, 120 30, 120 70 C120 75, 40 75, 40 70 Z" fill="#522707"/>
              <circle cx="120" cy="65" r="10" fill="#421d04"/>
              <ellipse cx="80" cy="80" rx="35" ry="32" fill="#ffd8b3"/>
              <path d="M72 88 Q80 95 88 88" stroke="#8b4513" stroke-width="3" stroke-linecap="round" fill="none"/>
              <path d="M50 110 L110 110 L125 170 L35 170 Z" fill="#8b5a2b"/>
              <g font-family="'Noto Sans Javanese'" font-size="16" font-weight="bold" fill="#d97706">
                <text x="25" y="60" class="animate-bounce">ꦏ</text>
                <text x="125" y="55" class="animate-bounce" style="animation-delay: 0.2s">ꦭ</text>
              </g>
            </svg>
          </div>

          <div class="space-y-2 my-2 w-full">
            <h3 class="font-game font-black text-lg text-amber-950 uppercase tracking-wide">4. NYUSUN AKSARA</h3>
            <p class="text-xs text-stone-600 font-semibold px-1">Arranged cards menyang kothak sing bener.</p>

            <div class="pt-1" onclick="event.stopPropagation()">
              <select id="nyusun-level-select" class="w-full bg-amber-50 border-2 border-amber-800 text-amber-950 text-xs font-extrabold rounded-lg p-1.5 focus:outline-none cursor-pointer text-center">
                <option value="gampang">Level: GAMPANG</option>
                <option value="sedengan">Level: SEDENGAN</option>
                <option value="angel">Level: ANGEL</option>
              </select>
            </div>
          </div>

          <div class="w-full pt-2 flex gap-1.5" onclick="event.stopPropagation()">
            <button onclick="playAudioPop(); startNyusunDirect('1P')" class="btn-green btn-card-action flex-1 py-2 rounded-xl font-game font-bold text-white text-xs uppercase tracking-wider">
              1 Pemain
            </button>
            <button onclick="playAudioPop(); startNyusunDirect('2P')" class="btn-blue btn-card-action flex-1 py-2 rounded-xl font-game font-bold text-white text-xs uppercase tracking-wider">
              2P ⚔️
            </button>
          </div>
        </div>

        <!-- CARD 5: PECAH GELEMBUNG (BUBBLE POP AKSARA) -->
        <div class="wood-card card-interactive p-5 flex flex-col justify-between items-center text-center group border-amber-500 bg-amber-50/50" onclick="playAudioPop(); triggerGelembungFromCard()">
          <div class="w-full flex justify-center py-2 relative">
            <svg class="w-32 h-36 char-img transition-transform duration-300" viewBox="0 0 160 180" fill="none">
              <!-- Animated background bubbles in SVG -->
              <circle cx="40" cy="50" r="18" fill="#3b82f6" opacity="0.3" class="animate-bounce"/>
              <circle cx="120" cy="40" r="22" fill="#10b981" opacity="0.3" class="animate-pulse"/>
              <circle cx="80" cy="130" r="25" fill="#f59e0b" opacity="0.3"/>
              
              <!-- Character popping bubble -->
              <ellipse cx="80" cy="85" rx="35" ry="32" fill="#ffd8b3"/>
              <circle cx="68" cy="80" r="4" fill="#2d1810"/>
              <circle cx="92" cy="80" r="4" fill="#2d1810"/>
              <path d="M72 92 Q80 102 88 92" stroke="#8b4513" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              <path d="M50 115 L110 115 L125 170 L35 170 Z" fill="#8b5a2b"/>

              <!-- Main Bubble Icon with Aksara -->
              <circle cx="80" cy="48" r="26" fill="url(#bubbleGrad)" stroke="#ffffff" stroke-width="3" opacity="0.9"/>
              <text x="68" y="56" font-family="'Noto Sans Javanese'" font-size="22" fill="#ffffff" font-weight="bold">ꦏ</text>
              <circle cx="70" cy="36" r="6" fill="#ffffff" opacity="0.6"/>

              <defs>
                <linearGradient id="bubbleGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#38bdf8"/>
                  <stop offset="100%" stop-color="#0284c7"/>
                </linearGradient>
              </defs>
            </svg>
          </div>

          <div class="space-y-2 my-2 w-full">
            <div class="inline-block bg-amber-500 text-white font-black text-[10px] px-2 py-0.5 rounded-full uppercase tracking-wider">Game Anyar 🎈</div>
            <h3 class="font-game font-black text-lg text-amber-950 uppercase tracking-wide leading-tight">5. PECAH GELEMBUNG</h3>
            <p class="text-xs text-stone-600 font-semibold px-1">Pecahke gelembung aksara sing bener!</p>

            <div class="pt-1" onclick="event.stopPropagation()">
              <select id="gelembung-speed-select" class="w-full bg-amber-50 border-2 border-amber-800 text-amber-950 text-xs font-extrabold rounded-lg p-1.5 focus:outline-none cursor-pointer text-center">
                <option value="alon">Kecepatan: ALON</option>
                <option value="sedengan" selected>Kecepatan: SEDENGAN</option>
                <option value="banter">Kecepatan: BANTER</option>
              </select>
            </div>
          </div>

          <div class="w-full pt-2 flex gap-1.5" onclick="event.stopPropagation()">
            <button onclick="playAudioPop(); startGelembungDirect('1P')" class="btn-green btn-card-action flex-1 py-2 rounded-xl font-game font-bold text-white text-xs uppercase tracking-wider">
              1 Pemain
            </button>
            <button onclick="playAudioPop(); startGelembungDirect('2P')" class="btn-blue btn-card-action flex-1 py-2 rounded-xl font-game font-bold text-white text-xs uppercase tracking-wider">
              2P ⚔️
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION 1: SINAU AKSARA (MATERI LENGKAP) -->
